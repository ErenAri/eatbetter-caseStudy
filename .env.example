# Server-only configuration. Copy to backend/.env for local development.
APP_ENV=local
APP_DEBUG=false
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
SUPABASE_URL=https://PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=meal-images
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
VISION_PROVIDER=demo
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_IMAGE_DETAIL=high
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_ATTEMPTS=3
CANONICALIZATION_PROVIDER=demo
OPENAI_CANONICALIZATION_MODEL=gpt-5.6-terra
OPENAI_CANONICALIZATION_REASONING_EFFORT=low
OPENAI_CANONICALIZATION_TIMEOUT_SECONDS=25
OPENAI_CANONICALIZATION_MAX_ATTEMPTS=3
USDA_API_KEY=YOUR_USDA_API_KEY
# Accepted values: demo, usda, ai
NUTRITION_PROVIDER=demo
USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1
USDA_TIMEOUT_SECONDS=8
USDA_SEARCH_LIMIT=15
USDA_MAX_ATTEMPTS=3
AI_NUTRITION_MODEL=gpt-5.6-terra
AI_NUTRITION_SAMPLE_COUNT=3
SENTRY_DSN=
MAX_AUTO_ACCEPT_CALORIE_UNCERTAINTY_KCAL=100
MAX_AUTO_ACCEPT_RELATIVE_UNCERTAINTY=0.20
MIN_RELATIVE_TRIGGER_KCAL=25
MAX_NUTRITION_CONSENSUS_SPREAD=0.25

# Non-secret mobile configuration belongs in mobile/.env.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
